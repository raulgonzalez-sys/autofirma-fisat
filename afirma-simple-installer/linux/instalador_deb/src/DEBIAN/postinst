#!/bin/bash
aviso() { echo "autofirma $0: AVISO: $*" >&2; }

# Certificado raiz y almacen SSL, AutoFirma.js, extension CSP de Firefox y la parte de cada usuario
echo "Preparacion de AutoFirma: certificados, Firefox y Chrome"
/usr/bin/autofirma restaurar --sistema || aviso "la restauracion del sistema ha fallado"

# Creacion de certificado .pem y .crt para su importacion en el almacenamiento del sistema
openssl x509 -inform der -in /usr/lib/Autofirma/Autofirma_ROOT.cer -out /usr/lib/Autofirma/Autofirma_ROOT.pem || aviso "openssl no pudo convertir Autofirma_ROOT.cer"

mv -f /usr/lib/Autofirma/Autofirma_ROOT.pem /usr/lib/Autofirma/Autofirma_ROOT.crt || aviso "no se pudo renombrar Autofirma_ROOT.pem"

rm -rf /usr/share/ca-certificates/Autofirma/ || aviso "no se pudo borrar /usr/share/ca-certificates/Autofirma/"

mkdir -p /usr/share/ca-certificates/Autofirma/ /usr/local/share/ca-certificates/ || aviso "no se pudieron crear los directorios de certificados"
cp /usr/lib/Autofirma/Autofirma_ROOT.crt /usr/share/ca-certificates/Autofirma/Autofirma_ROOT.crt || aviso "no se pudo copiar el certificado a /usr/share/ca-certificates"
cp /usr/lib/Autofirma/Autofirma_ROOT.crt /usr/local/share/ca-certificates/Autofirma_ROOT.crt || aviso "no se pudo copiar el certificado a /usr/local/share/ca-certificates"
update-ca-certificates || aviso "update-ca-certificates ha fallado"
echo "Instalacion del certificado CA en el almacenamiento del sistema"

# borramos el fichero de instalacion
rm -f /usr/lib/Autofirma/Autofirma_ROOT.crt || aviso "no se pudo borrar Autofirma_ROOT.crt"
echo "AutoFirma: reinicie Chrome (o cierre la sesión y vuelva a entrar) para que AutoFirma funcione desde la web."
exit 0
