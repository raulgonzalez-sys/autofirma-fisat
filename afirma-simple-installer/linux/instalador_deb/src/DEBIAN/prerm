#!/bin/bash
aviso() { echo "autofirma $0: AVISO: $*" >&2; }

# Quita la clave de la extension CSP de policies.json solo al desinstalar (nunca al actualizar).
# Tiene que ser aqui: dpkg borra los ficheros del paquete antes de postrm y el ayudante ya no existiria
case "$1" in
	remove|deconfigure)
		for pj in /etc/firefox/policies/policies.json /etc/firefox-esr/policies/policies.json; do
			/usr/lib/Autofirma/fisat-politicas.py remove "$pj" autofirma-csp-fix@local --delete-if-empty || aviso "no se pudo quitar la extension CSP de $pj"
		done
		# Retira la CA de los almacenes de cada usuario (como cada usuario, con timeout; nunca aborta prerm)
		/usr/lib/Autofirma/fisat-retirar.sh || aviso "fisat-retirar.sh ha fallado"
		;;
esac

# Eliminamos los enlaces creados en el script de postinstalacion y los heredados del paquete oficial
rm -f /etc/icecat/pref/AutoFirma.js || aviso "no se pudo borrar /etc/icecat/pref/AutoFirma.js"
rm -f /etc/firefox-esr/pref/AutoFirma.js || aviso "no se pudo borrar /etc/firefox-esr/pref/AutoFirma.js"
rm -f /etc/icecat/pref/Autofirma.js /etc/firefox-esr/pref/Autofirma.js || aviso "no se pudieron borrar los enlaces Autofirma.js heredados"

# damos permisos de desinstalacion de los certificados del almacen de firefox
if [ -f "/usr/lib/Autofirma/uninstall.sh" ]; then
	chmod +x /usr/lib/Autofirma/uninstall.sh || aviso "no se pudo dar permiso a uninstall.sh"
	/usr/lib/Autofirma/uninstall.sh || aviso "uninstall.sh ha fallado"
	echo "Se ha borrado el certificado CA de los almacenes de Firefox"
fi

# borramos los certificados instalados en el almacenamiento del sistema
rm -rf /usr/share/ca-certificates/Autofirma || aviso "no se pudo borrar /usr/share/ca-certificates/Autofirma"
rm -f /usr/local/share/ca-certificates/Autofirma_ROOT.crt || aviso "no se pudo borrar Autofirma_ROOT.crt"
rm -f /usr/lib/Autofirma/uninstall.sh || aviso "no se pudo borrar uninstall.sh"
rm -f /usr/lib/Autofirma/autofirma.pfx || aviso "no se pudo borrar autofirma.pfx"
rm -f /usr/lib/Autofirma/Autofirma_ROOT.cer || aviso "no se pudo borrar Autofirma_ROOT.cer"

update-ca-certificates || aviso "update-ca-certificates ha fallado"

echo "Se ha borrado el certificado CA en el almacenamiento del sistema"

exit 0
