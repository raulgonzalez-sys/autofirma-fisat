#!/bin/bash
aviso() { echo "autofirma $0: AVISO: $*" >&2; }

# generamos certificado CA y SSL
java -jar /usr/lib/Autofirma/autofirmaConfigurador.jar || aviso "el configurador ha fallado"
# el paso por usuario lee el certificado como usuario
chmod 644 /usr/lib/Autofirma/Autofirma_ROOT.cer || aviso "no se pudo dar permiso de lectura a Autofirma_ROOT.cer"

# damos permiso al script de instalacion del certificado para firefox y lo ejecutamos
echo "Generacion de certificados"

if [ -f "/usr/lib/Autofirma/script.sh" ]; then
	chmod +x /usr/lib/Autofirma/script.sh || aviso "no se pudo dar permiso a script.sh"
	/usr/lib/Autofirma/script.sh || aviso "script.sh ha fallado"
fi

echo "Instalacion del certificado CA en el almacenamiento de Firefox y Chrome"

# Creacion de certificado .pem y .crt para su importacion en el almacenamiento del sistema
openssl x509 -inform der -in /usr/lib/Autofirma/Autofirma_ROOT.cer -out /usr/lib/Autofirma/Autofirma_ROOT.pem || aviso "openssl no pudo convertir Autofirma_ROOT.cer"

mv -f /usr/lib/Autofirma/Autofirma_ROOT.pem /usr/lib/Autofirma/Autofirma_ROOT.crt || aviso "no se pudo renombrar Autofirma_ROOT.pem"

rm -rf /usr/share/ca-certificates/Autofirma/ || aviso "no se pudo borrar /usr/share/ca-certificates/Autofirma/"

mkdir -p /usr/share/ca-certificates/Autofirma/ /usr/local/share/ca-certificates/ || aviso "no se pudieron crear los directorios de certificados"
cp /usr/lib/Autofirma/Autofirma_ROOT.crt /usr/share/ca-certificates/Autofirma/Autofirma_ROOT.crt || aviso "no se pudo copiar el certificado a /usr/share/ca-certificates"
cp /usr/lib/Autofirma/Autofirma_ROOT.crt /usr/local/share/ca-certificates/Autofirma_ROOT.crt || aviso "no se pudo copiar el certificado a /usr/local/share/ca-certificates"
update-ca-certificates || aviso "update-ca-certificates ha fallado"
echo "Instalacion del certificado CA en el almacenamiento del sistema"

# Enlazamos el fichero de asociacion del protocolo "afirma" en Firefox
# para que aplique a otros navegadores
if [ -d /etc/icecat ] ; then
	mkdir -p /etc/icecat/pref || aviso "no se pudo crear /etc/icecat/pref"
	ln -sfn /etc/firefox/pref/AutoFirma.js /etc/icecat/pref/AutoFirma.js || aviso "no se pudo enlazar /etc/icecat/pref/AutoFirma.js"
fi
if [ -d /etc/firefox-esr ] ; then
	mkdir -p /etc/firefox-esr/pref || aviso "no se pudo crear /etc/firefox-esr/pref"
	ln -sfn /etc/firefox/pref/AutoFirma.js /etc/firefox-esr/pref/AutoFirma.js || aviso "no se pudo enlazar /etc/firefox-esr/pref/AutoFirma.js"
fi

# borramos los ficheros de instalacion
rm -f /usr/lib/Autofirma/script.sh /usr/lib/Autofirma/Autofirma_ROOT.crt || aviso "no se pudieron borrar los ficheros de instalacion"
exit 0
